generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  photo             String?
  role              Role
  deleted_at        DateTime?
  created_at        DateTime
  updated_at        DateTime
  isActive          Boolean

  // Relations
  films             Film[]
  cast              Cast[]
  film_casts        FilmCast[]
  comments          Comment[]
}

model Film {
  id                String    @id @default(uuid())
  title             String
  poster            String?
  typeMov           movieType @default(movie)
  description       String?
  release_year      Int
  duration          Int?
  episode           Int?
  rating            Rate
  watchlist         Int?
  creator           String
  cast              String
  trailer           String?
  trailerUrl        String?
  postedBy          String
  archived_at       DateTime?
  created_at        DateTime
  updated_at        DateTime

  // Relations
  createdBy         users     @relation(fields: [postedBy], references: [id])
  genres_relations  GenreRelation[]
  comments          Comment[]
  film_casts        FilmCast[]
}

model Cast {
  id                String    @id @default(uuid())
  name              String
  photo             String?
  createdBy         String
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  // Relations
  film_casts        FilmCast[]
  created_by        users     @relation(fields: [createdBy], references: [id])
}

model FilmCast {
  id                String    @id @default(uuid())
  film_id           String
  cast_id           String
  character_name    String?
  createdBy         String
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  // Relations
  film              Film      @relation(fields: [film_id], references: [id], onDelete: Cascade)
  cast              Cast      @relation(fields: [cast_id], references: [id], onDelete: Cascade)
  created_by        users     @relation(fields: [createdBy], references: [id])
}


model Genre {
  id                String    @id @default(uuid())
  title             String
  deleted_at        DateTime?
  created_at        DateTime
  updated_at        DateTime

  // Relations
  genres_relations  GenreRelation[]
}

model GenreRelation {
  id                String    @id @default(uuid())
  film_id           String
  genre_id          String
  created_at        DateTime
  updated_at        DateTime

  // Relations
  film              Film      @relation(fields: [film_id], references: [id], onDelete: Cascade)
  genre             Genre     @relation(fields: [genre_id], references: [id])
}

model Comment {
  id                String    @id @default(uuid())
  comment           String
  rating            CommentRating
  user_id           String
  film_id           String
  created_at        DateTime
  updated_at        DateTime

  // Relations
  user              users      @relation(fields: [user_id], references: [id])
  film              Film      @relation(fields: [film_id], references: [id])
}

enum Role {
  subs
  admin
  author
}

enum CommentRating {
  one
  two
  three
  four
  five
}

enum Rate {
  G
  PG
  PG13
  R
  NC17
  TVY
  TVY7
  TVG
  TVPG
  TV14
  TVMA
}

enum movieType {
  movie
  series
}